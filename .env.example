DATABASE_URL=postgresql://filecloud:filecloud@postgres:5432/filecloud
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Leave unset: NEXT_PUBLIC_* is inlined at build time, and unset means the
# browser calls whichever origin served the page.
NEXT_PUBLIC_BETTER_AUTH_URL=

S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=filecloud
# Browser-facing S3 URL for presigned PUT/GET. Inside Docker Compose the API
# is published on localhost:9010 even though the container listens on 9000.
S3_PUBLIC_ENDPOINT=http://localhost:9010

# Defaults for new instance settings (admins can change them in the UI later).
MAX_UPLOAD_BYTES=5368709120
MAX_WORKSPACE_BYTES=10737418240

# Set to true ONLY when a trusted reverse proxy sets X-Forwarded-For. It is
# what makes per-IP rate limiting work: while false, forwarded headers are
# ignored (a client could otherwise pick its own bucket) and anonymous callers
# share one bucket per endpoint.
TRUST_PROXY=false
DATABASE_POOL_MAX=10
DATABASE_SSL=false
# Only used when DATABASE_SSL=true. Set to false for some managed Postgres
# providers that present a private CA.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Comma-separated emails promoted to role=admin on every login. This is how
# the first admin is bootstrapped. Listing an address is not proof of owning
# it, so once the instance has an admin, promotion also requires a verified
# email (social sign-in provides one); grant later admins from the admin panel.
ADMIN_EMAILS=

# Optional. Signs the cookie proving a password-protected share link was
# unlocked. Defaults to BETTER_AUTH_SECRET; set it to rotate the two secrets
# independently.
SHARE_UNLOCK_SECRET=

# Development only, and ignored on a production build. Prints login OTP codes
# to the server log because there is no mailer yet.
AUTH_DEBUG_OTP=false

# Optional. Enables "Continue with GitHub" / "Continue with Google".
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Protects POST /api/cron/purge-trash (Authorization: Bearer …).
# The worker already purges trash; this is only needed without a worker.
CRON_SECRET=

# Optional. Defaults to AloneDay-91/filecloud-v2. Used by the admin update banner.
GITHUB_REPO=
# Optional. Raises GitHub API rate limits for release checks.
GITHUB_TOKEN=
