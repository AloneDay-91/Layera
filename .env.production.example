# Copy to .env.production and fill in real, unique values.
# DATABASE_URL is built from these by docker-compose.prod.yml — don't set it here.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://your-domain.example
NEXT_PUBLIC_BETTER_AUTH_URL=https://your-domain.example

S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=filecloud
# Browser-facing S3 URL for presigned PUTs. Leave unset to upload through
# the Next.js app instead (required when MinIO is not reachable from the browser).
S3_PUBLIC_ENDPOINT=
MAX_UPLOAD_BYTES=5368709120
MAX_WORKSPACE_BYTES=10737418240
TRUST_PROXY=true
DATABASE_POOL_MAX=10
DATABASE_SSL=false
CRON_SECRET=
# Pin the GHCR web image tag (v1.2.0). Defaults to latest.
LAYERA_VERSION=
# Optional. Defaults to AloneDay-91/filecloud-v2.
GITHUB_REPO=
# Optional. Raises GitHub API rate limits for the in-app update banner.
GITHUB_TOKEN=
