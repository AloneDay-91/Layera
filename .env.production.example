# Copy to .env.production and fill in real, unique values.
# DATABASE_URL is built from these by docker-compose.prod.yml — don't set it here.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://your-domain.example
NEXT_PUBLIC_BETTER_AUTH_URL=https://your-domain.example

S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=filecloud
# Browser-facing S3 URL for presigned PUTs. Leave unset to upload through
# the Next.js app instead (required when MinIO is not reachable from the browser).
S3_PUBLIC_ENDPOINT=
MAX_UPLOAD_BYTES=5368709120
MAX_WORKSPACE_BYTES=10737418240

# The prod compose stack sits behind a reverse proxy. Keep this true so
# per-IP rate limiting sees real client addresses; set it to false if the app
# is ever reachable directly, since an untrusted X-Forwarded-For would let a
# caller choose its own rate limit bucket.
TRUST_PROXY=true
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Comma-separated emails promoted to role=admin on every login. Required to
# bootstrap the first admin on a fresh instance. Set it before the instance is
# publicly reachable: once an admin exists, promotion additionally requires a
# verified email, and later admins should be granted from the admin panel.
ADMIN_EMAILS=

# Optional. Signs the cookie proving a password-protected share link was
# unlocked. Defaults to BETTER_AUTH_SECRET; set it to rotate independently.
SHARE_UNLOCK_SECRET=

# Optional. Enables "Continue with GitHub" / "Continue with Google".
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Protects POST /api/cron/purge-trash. The worker already purges
# trash on a timer; set this only if you call the HTTP endpoint instead.
CRON_SECRET=

# Pin the GHCR web image tag (v1.1.0). Defaults to latest.
LAYERA_VERSION=
# Optional. Defaults to AloneDay-91/filecloud-v2.
GITHUB_REPO=
# Optional. Raises GitHub API rate limits for the in-app update banner.
GITHUB_TOKEN=
